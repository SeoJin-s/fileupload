<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>새 게시물</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
  <style>
    body {
      background-color: #fff;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;
      padding-bottom: 100px;
    }
    .form-container {
      max-width: 500px;
      margin: 0 auto;
      padding: 1rem;
    }
      .preview-img {
	    width: 100%;
	    height: 200px;
	    background: #f5f5f5;
	    border-radius: 10px;
	    display: flex;
	    justify-content: center;
	    align-items: center;
	    overflow: hidden;
	    margin-bottom: 1rem;
	    transition: all 0.3s ease;
	    cursor: pointer;
	  }
	  .preview-img img {
	    height: 100%;
	    object-fit: cover;
	    transition: all 0.3s ease;
	  }
	  .preview-img.expanded {
	    height: auto;
	    max-height: none;
	  }
	  .preview-img.expanded img {
	    height: auto;
	    width: 100%;
	    object-fit: contain;
	  }ject-fit: cover;
		}
    .fixed-bottom-btn {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: #fff;
      padding: 1rem;
      border-top: 1px solid #ddd;
      z-index: 999;
    }
    .option-btn {
      width: 100%;
      text-align: left;
      margin-bottom: 0.75rem;
    }
    .tag-btn {
      background-color: #f0f0f0;
      border: none;
      padding: 6px 12px;
      border-radius: 20px;
      margin: 4px;
      display: inline-block;
    }
  </style>
</head>
<body>

<div class="form-container">
  <h5 class="fw-bold text-center my-3">새 게시물</h5>

  <form method="post" action="/addBoard" enctype="multipart/form-data">
    <!-- 이미지 업로드 -->
    <div class="mb-3">
      <label class="form-label">사진 업로드</label>
      <input type="file" name="fileList" class="form-control" onchange="previewImage(event)" required>
    </div>

    <!-- 이미지 미리보기 -->
    <div id="imagePreview" class="preview-img">
      미리보기 이미지
    </div>

    <!-- 문구 입력 -->
    <div class="mb-3">
      <textarea name="title" class="form-control" placeholder="문구 추가..." rows="3"></textarea>
    </div>

    <!-- 설정 옵션들 -->
    <button type="button" class="btn btn-outline-secondary option-btn">
      <i class="bi bi-person-plus me-2"></i> 사람 태그
    </button>
    <button type="button" class="btn btn-outline-secondary option-btn">
      <i class="bi bi-geo-alt me-2"></i> 위치 추가
    </button>
    <div class="mb-2">
      <span class="tag-btn">Gwangmyeong</span>
      <span class="tag-btn">Seoul</span>
    </div>
    <button type="button" class="btn btn-outline-secondary option-btn">
      <i class="bi bi-music-note-beamed me-2"></i> 음악 추가
    </button>
    <button type="button" class="btn btn-outline-secondary option-btn">
      <i class="bi bi-robot me-2"></i> AI 레이블 추가
    </button>

    <!-- 비밀번호 필드 (숨김 또는 hidden 처리 가능) -->
    <input type="hidden" name="pw" value="1234">
    
    <!-- 하단 고정 공유 버튼 -->
    <div class="fixed-bottom-btn">
      <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">공유하기</button>
    </div>
  </form>
</div>

<script>
  function previewImage(event) {
    const reader = new FileReader();
    reader.onload = function(){
      const output = document.getElementById('imagePreview');
      output.classList.remove('expanded'); // 초기화
      output.innerHTML = `<img src="${reader.result}" class="w-100" onclick="toggleImageSize()">`;
    };
    reader.readAsDataURL(event.target.files[0]);
  }

  function toggleImageSize() {
    const container = document.getElementById('imagePreview');
    container.classList.toggle('expanded');
  }
</script>

</body>
</html>
