<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>게시물 수정</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
  <style>
    body {
      background-color: #fff;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;
      padding-bottom: 80px;
      margin-top: 60px;
    }
    .form-container {
      max-width: 500px;
      margin: 0 auto;
      padding: 1rem;
    }
    .preview-img {
      width: 100%;
      height: 200px;
      background: #f5f5f5;
      border-radius: 10px;
      display: flex;
      justify-content: center;
      align-items: center;
      overflow: hidden;
      transition: all 0.3s ease;
      cursor: pointer;
    }
    .preview-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: all 0.3s ease;
    }
    .preview-img.expanded {
      height: auto;
      max-height: none;
      position: relative;
      z-index: 1000;
    }
    .preview-img.expanded img {
      width: 100%;
      height: auto;
      object-fit: contain;
    }
  </style>
</head>
<body>

<!-- 상단 고정 로고 -->
<div class="position-fixed top-0 start-0 end-0 bg-white border-bottom text-center py-2" style="z-index: 1000; height: 48px;">
  <img src="/img/instagram-logo.png" height="36" alt="Instagram Logo">
</div>

<div class="form-container">

  <!-- 상단 네비게이션 바 -->
  <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
    <a href="/boardOne?bno={{board.bno}}" class="text-dark text-decoration-none fs-5">
      <i class="bi bi-chevron-left"></i>
    </a>
    <span class="fw-bold fs-5">정보 수정</span>
    <button type="submit" form="modifyForm" class="btn btn-link text-primary text-decoration-none fw-semibold px-0">
      완료
    </button>
  </div>

  <!-- ✅ 수정 form -->
  <form id="modifyForm" method="post" action="/modifyBoard" enctype="multipart/form-data">
    <input type="hidden" name="bno" value="{{board.bno}}">

    <!-- 미리보기 -->
    <div id="imagePreview" class="preview-img mb-3" onclick="toggleImageSize(event)">
      {{#fileList}}
        <img src="/upload/{{fname}}.{{fext}}" alt="{{foriginname}}">
      {{/fileList}}
      {{^fileList}}
        <span class="text-muted">이미지 미리보기</span>
      {{/fileList}}
    </div>

    <!-- 제목 수정 -->
    <div class="mb-3">
      <textarea name="title" class="form-control" placeholder="문구 수정..." rows="3" required>{{board.title}}</textarea>
    </div>

    <!-- 새 파일 업로드 -->
    <div class="mb-3">
      <label class="form-label">📎 새 이미지 업로드 (선택)</label>
      <input type="file" name="file" class="form-control" onchange="previewFile(event)">
    </div>

    <!-- 비밀번호 확인 -->
    <div class="mb-3">
      <input type="password" name="pw" class="form-control" placeholder="비밀번호 확인" required>
    </div>
  </form>

  <!-- 삭제 버튼은 별도 GET 방식 -->
  {{#fileList}}
    <form method="get" action="/removeBoardfile" class="text-end mt-2">
      <input type="hidden" name="fno" value="{{fno}}">
      <input type="hidden" name="bno" value="{{board.bno}}">
      <button type="submit" class="btn btn-sm btn-outline-danger"
              onclick="return confirm('정말 이미지를 삭제할까요?');">
        🗑 이미지 삭제
      </button>
    </form>
  {{/fileList}}

</div>

<script>
  function previewFile(event) {
    const input = event.target;
    const preview = document.getElementById('imagePreview');
    const file = input.files[0];
    if (file && file.type.startsWith('image/')) {
      const reader = new FileReader();
      reader.onload = function(e) {
        preview.innerHTML = `<img src="${e.target.result}" alt="미리보기">`;
      }
      reader.readAsDataURL(file);
    }
  }

  function toggleImageSize(event) {
    const preview = document.getElementById('imagePreview');
    preview.classList.toggle('expanded');
    if (preview.classList.contains('expanded')) {
      setTimeout(() => {
        document.addEventListener('click', outsideImageClickHandler);
      }, 10);
    } else {
      document.removeEventListener('click', outsideImageClickHandler);
    }
    event.stopPropagation();
  }

  function outsideImageClickHandler(event) {
    const preview = document.getElementById('imagePreview');
    if (!preview.contains(event.target)) {
      preview.classList.remove('expanded');
      document.removeEventListener('click', outsideImageClickHandler);
    }
  }
</script>

</body>
</html>
